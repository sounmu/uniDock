{
  "name": "unidock",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "postinstall": "wxt prepare",
    "typecheck": "wxt prepare && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,mjs,cjs}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,mjs,cjs}\"",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "check": "npm run pages:check && npm run lint && npm run typecheck && npm test && npm run build",
    "pages:sync": "node scripts/pages.mjs",
    "pages:check": "node scripts/pages.mjs --check",
    "contract:refresh": "python3 -B scripts/generate_contract.py && python3 -B scripts/generate_caption_contract.py",
    "contract:check": "python3 -B scripts/generate_contract.py --check && python3 -B scripts/generate_caption_contract.py --check",
    "release": "npm run notices && npm run check && npm audit --audit-level=moderate && node scripts/package-release.mjs",
    "store:assets": "node scripts/brand-assets.mjs && node scripts/store-assets.mjs",
    "notices": "node scripts/notices.mjs",
    "test:captions:live": "node scripts/test-caption-live.mjs",
    "demo": "npm run build && node scripts/demo.mjs"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/chrome": "0.2.9",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.0",
    "@wxt-dev/module-react": "1.2.2",
    "eslint": "10.10.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.0",
    "wxt": "0.21.4"
  }
}
